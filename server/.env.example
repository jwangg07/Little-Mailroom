GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false
# Explicit local development only. Lambda always requires DynamoDB.
AUTH_STORE=memory
# For shared AWS authentication, set AUTH_STORE=dynamodb and the table name:
# DYNAMODB_TABLE=mini-mailroom-auth
# Lambda uses the bare Secrets Manager ARN, retrieving the JSON key itself.
# GOOGLE_CLIENT_SECRET_ARN=arn:aws:secretsmanager:us-east-2:ACCOUNT_ID:secret:SECRET_NAME-SUFFIX
