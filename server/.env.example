GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false
APP_ENV=development
# Production on ANY host requires APP_ENV=production, HTTPS URLs, Secure cookies,
# DynamoDB, Secrets Manager, and KMS. Lambda enforces these automatically.
# Explicit local development only. Lambda always requires DynamoDB.
AUTH_STORE=memory
# Memory mode generates a temporary encryption key; restart clears mail credentials.
# DynamoDB outside Lambda requires this stable base64-encoded 32-byte key OR KMS:
# CREDENTIAL_ENCRYPTION_KEY=...
# Lambda requires a customer-managed symmetric KMS key ARN:
# CREDENTIAL_KMS_KEY_ID=arn:aws:kms:us-east-2:ACCOUNT_ID:key/KEY_ID
# For shared AWS authentication, set AUTH_STORE=dynamodb and the table name:
# DYNAMODB_TABLE=mini-mailroom-auth
# Lambda uses the bare Secrets Manager ARN, retrieving the JSON key itself.
# GOOGLE_CLIENT_SECRET_ARN=arn:aws:secretsmanager:us-east-2:ACCOUNT_ID:secret:SECRET_NAME-SUFFIX
# Optional fixed-window quotas, shared across instances when using DynamoDB:
# LOGIN_REQUESTS_PER_MINUTE=10
# MAIL_REQUESTS_PER_MINUTE=30
# SEND_REQUESTS_PER_MINUTE=5
